---
import '../styles/global.css'
import { absoluteUrl, servidor, url } from '../lib/site'
import { DEFAULT_LOCALE, getCopy, type Locale } from '../i18n/copy'

interface Props {
  /** Título de la pestaña. Por defecto, el aprobado para la portada. */
  title?: string
  description?: string
  /** Titular del hero: Open Graph usa el mismo texto. */
  ogTitle?: string
  /** Imagen de Open Graph, 1200×630. `public/og.png` en las seis rutas (MAK-231). */
  ogImage?: string
  ogImageAlt?: string
  /** Ruta canónica de la página, con base aplicado. */
  path?: string
  /** Idioma de esta página. Por defecto español, como antes de MAK-274. */
  lang?: Locale
  /**
   * Rutas (sin idioma) que tienen versión publicada en cada idioma, para el
   * `<link rel="alternate" hreflang>`. Por defecto esta misma página no
   * existe en más idiomas todavía, así que solo se autorreferencia.
   */
  translations?: Partial<Record<Locale, string>>
}

const { meta, saltar } = getCopy(Astro.props.lang ?? DEFAULT_LOCALE)
const {
  title = meta.titulo,
  description = meta.descripcion,
  ogTitle = title,
  ogImage,
  ogImageAlt,
  path = '/',
  lang = DEFAULT_LOCALE,
  translations = { [lang]: path },
} = Astro.props

const canonical = absoluteUrl(path, lang)

/**
 * Indexable en los dos idiomas. `/en/` llevó `noindex` mientras su copy era
 * provisional (MAK-274); desde el 25-09-2026, con el copy aprobado, el ejemplo
 * de idiomas mezclados real y la descarga en inglés ya publicados, Gonzalo
 * pidió que Google pudiera indexarla. Solo `/og` (el molde de la tarjeta)
 * sigue sin indexarse, y lo hace por su cuenta en `og.astro`.
 */
const sugerencias = { es: getCopy('es').sugerenciaIdioma, en: getCopy('en').sugerenciaIdioma }
const OG_LOCALES: Record<Locale, string> = { es: 'es_ES', en: 'en_US' }
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Indexable desde el 15-09-2026: decisión humana explícita de Álvaro en MAK-71
      («Quitar el noindex y desbloquear robots.txt — esto hazlo ya»). Dominio propio
      (echo.make-algo.com) conectado en GitHub Pages; ver astro.config.mjs.
      `/en/` se indexa desde el 25-09-2026 (decisión de Gonzalo, ver arriba).
    */}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      (Object.entries(translations) as [Locale, string][]).map(([l, p]) => (
        <link rel="alternate" hreflang={l} href={absoluteUrl(p, l)} />
      ))
    }
    {
      translations[DEFAULT_LOCALE] && (
        <link rel="alternate" hreflang="x-default" href={absoluteUrl(translations[DEFAULT_LOCALE]!, DEFAULT_LOCALE)} />
      )
    }

    {/*
      Idioma: la URL lo fija (`/` o `/en/`) para que buscadores y vistas previas
      de enlaces vean cada idioma en su dirección, y esto lo adapta a quien
      entra, sin redirigir nunca a nadie que no haya elegido:
      - Si eligió idioma (selector de la cabecera, enlace del pie o el aviso),
        se guarda en `localStorage` y al volver se le lleva a su versión antes
        de pintar nada. Un rastreador no guarda nada, así que nunca se le
        redirige y cada idioma sigue indexándose en su URL.
      - Si no eligió y su sistema está en el otro idioma, un aviso le ofrece
        la otra versión con un clic. No redirige: una redirección por idioma
        del navegador también se la llevaría el rastreador de Google.
      Se guarda solo tras un clic de la persona y solo el código del idioma.
      Va aquí, detrás de los `<link rel="alternate">`, porque los lee.
    */}
    <script is:inline define:vars={{ sugerencias }}>
      ;(function () {
        try {
          var CLAVE = 'echo-idioma'
          var raiz = document.documentElement
          var leer = function () {
            try { return localStorage.getItem(CLAVE) } catch (e) { return null }
          }
          var guardar = function (l) {
            try { localStorage.setItem(CLAVE, l) } catch (e) {}
          }
          var alterno = function (l) {
            var e = document.querySelector('link[rel="alternate"][hreflang="' + l + '"]')
            // Misma ruta, en el dominio desde el que se navega (el canónico
            // es absoluto a producción y en local llevaría fuera).
            return e ? location.origin + new URL(e.href).pathname : null
          }
          var aqui = location.origin + location.pathname
          var llevarA = function (l) {
            var destino = alterno(l)
            if (!destino || destino === aqui) return false
            location.replace(destino + location.search + location.hash)
            return true
          }

          var elegido = leer()
          if (elegido && elegido !== raiz.lang && llevarA(elegido)) return

          document.addEventListener('click', function (e) {
            var a = e.target && e.target.closest ? e.target.closest('a[hreflang]') : null
            if (a) guardar(a.getAttribute('hreflang'))
          })

          document.addEventListener('DOMContentLoaded', function () {
            var bilingue = !!document.querySelector('[data-lang]')
            var otro = raiz.lang === 'es' ? 'en' : 'es'
            var hayOtro = bilingue || !!alterno(otro)

            var selectores = document.querySelectorAll('[data-selector-idioma]')
            for (var i = 0; i < selectores.length; i++) {
              if (!hayOtro) continue
              selectores[i].hidden = false
              selectores[i].addEventListener('change', function (e) {
                var l = e.target.value
                guardar(l)
                if (!llevarA(l)) document.dispatchEvent(new CustomEvent('echo:idioma', { detail: l }))
              })
            }

            // /descarga elige idioma por su cuenta (mismo URL, dos bloques).
            if (elegido || bilingue) return
            var sistema = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase()
            var preferido = /^es\b/.test(sistema) ? 'es' : 'en'
            var destino = alterno(preferido)
            if (preferido === raiz.lang || !destino || destino === aqui) return

            var t = sugerencias[preferido]
            var aviso = document.createElement('aside')
            aviso.className = 'aviso-idioma'
            aviso.lang = preferido
            aviso.setAttribute('aria-label', t.texto)
            var p = document.createElement('p')
            p.textContent = t.texto + ' '
            var ir = document.createElement('a')
            ir.href = destino + location.search + location.hash
            ir.hreflang = preferido
            ir.textContent = t.cambiar
            var quedarse = document.createElement('button')
            quedarse.type = 'button'
            quedarse.textContent = t.quedarse
            quedarse.addEventListener('click', function () {
              guardar(raiz.lang)
              aviso.remove()
            })
            p.appendChild(ir)
            aviso.appendChild(p)
            aviso.appendChild(quedarse)
            document.body.appendChild(aviso)
          })
        } catch (e) {}
      })()
    </script>

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={meta.nombre} />
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={absoluteUrl(ogImage)} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />

    <slot name="head" />
  </head>
  <body>
    <a href="#contenido" class="skip">{saltar}</a>
    <slot />

    {/*
      Medición de visitas. Va a nuestro propio servidor —el mismo Worker que emite las licencias—,
      no a una analítica de terceros: esta página promete que no carga nada de fuera (CA-NEG-9,
      comprobado en `npm run verificar`), y un script de Google o de Cloudflare contradiría de
      paso el argumento de venta de la propia landing.

      Suma uno a un contador por día, ruta, país y procedencia. No hay cookie, ni identificador de
      visitante, ni IP guardada, así que la política de privacidad puede seguir diciendo que esta
      web no usa cookies. Va `is:inline` para que siga siendo una etiqueta sin `src`: así no hay
      nada que cargar y la comprobación de recursos de terceros sigue teniendo sentido.

      Si el servidor no contesta, no pasa nada: `sendBeacon` no espera respuesta y el try/catch se
      come el resto. Ninguna visita se pierde por lentitud, y ninguna página se rompe por esto.

      La URL entra montada entera y no como `servidor + '/v1/visita'`: así aparece literal en el
      HTML publicado y se puede comprobar de un vistazo —y automáticamente— a dónde va esto.
    */}
    <script is:inline define:vars={{ medicion: `${servidor}/v1/visita` }}>
      try {
        navigator.sendBeacon(
          medicion,
          // `text/plain` a propósito: así es una petición simple y el navegador no manda antes un
          // preflight que retrasaría la medida (el Worker lo acepta igual, pero sobra).
          new Blob([JSON.stringify({ ruta: location.pathname, referrer: document.referrer })], {
            type: 'text/plain',
          })
        )
      } catch {}
    </script>
  </body>
</html>
