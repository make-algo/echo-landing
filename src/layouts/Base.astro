---
import '../styles/global.css'
import { absoluteUrl, servidor, url } from '../lib/site'
import { DEFAULT_LOCALE, getCopy, type Locale } from '../i18n/copy'

interface Props {
  /** Título de la pestaña. Por defecto, el aprobado para la portada. */
  title?: string
  description?: string
  /** Titular del hero: Open Graph usa el mismo texto. */
  ogTitle?: string
  /** Imagen de Open Graph, 1200×630. `public/og.png` en las seis rutas (MAK-231). */
  ogImage?: string
  ogImageAlt?: string
  /** Ruta canónica de la página, con base aplicado. */
  path?: string
  /** Idioma de esta página. Por defecto español, como antes de MAK-274. */
  lang?: Locale
  /**
   * Rutas (sin idioma) que tienen versión publicada en cada idioma, para el
   * `<link rel="alternate" hreflang>`. Por defecto esta misma página no
   * existe en más idiomas todavía, así que solo se autorreferencia.
   */
  translations?: Partial<Record<Locale, string>>
}

const { meta, saltar } = getCopy(Astro.props.lang ?? DEFAULT_LOCALE)
const {
  title = meta.titulo,
  description = meta.descripcion,
  ogTitle = title,
  ogImage,
  ogImageAlt,
  path = '/',
  lang = DEFAULT_LOCALE,
  translations = { [lang]: path },
} = Astro.props

const canonical = absoluteUrl(path, lang)

/**
 * Indexable en los dos idiomas. `/en/` llevó `noindex` mientras su copy era
 * provisional (MAK-274); desde el 25-09-2026, con el copy aprobado, el ejemplo
 * de idiomas mezclados real y la descarga en inglés ya publicados, Gonzalo
 * pidió que Google pudiera indexarla. Solo `/og` (el molde de la tarjeta)
 * sigue sin indexarse, y lo hace por su cuenta en `og.astro`.
 */
const OG_LOCALES: Record<Locale, string> = { es: 'es_ES', en: 'en_US' }
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Indexable desde el 15-09-2026: decisión humana explícita de Álvaro en MAK-71
      («Quitar el noindex y desbloquear robots.txt — esto hazlo ya»). Dominio propio
      (echo.make-algo.com) conectado en GitHub Pages; ver astro.config.mjs.
      `/en/` se indexa desde el 25-09-2026 (decisión de Gonzalo, ver arriba).
    */}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      (Object.entries(translations) as [Locale, string][]).map(([l, p]) => (
        <link rel="alternate" hreflang={l} href={absoluteUrl(p, l)} />
      ))
    }
    {
      translations[DEFAULT_LOCALE] && (
        <link rel="alternate" hreflang="x-default" href={absoluteUrl(translations[DEFAULT_LOCALE]!, DEFAULT_LOCALE)} />
      )
    }

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={meta.nombre} />
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={absoluteUrl(ogImage)} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />

    <slot name="head" />
  </head>
  <body>
    <a href="#contenido" class="skip">{saltar}</a>
    <slot />

    {/*
      Medición de visitas. Va a nuestro propio servidor —el mismo Worker que emite las licencias—,
      no a una analítica de terceros: esta página promete que no carga nada de fuera (CA-NEG-9,
      comprobado en `npm run verificar`), y un script de Google o de Cloudflare contradiría de
      paso el argumento de venta de la propia landing.

      Suma uno a un contador por día, ruta, país y procedencia. No hay cookie, ni identificador de
      visitante, ni IP guardada, así que la política de privacidad puede seguir diciendo que esta
      web no usa cookies. Va `is:inline` para que siga siendo una etiqueta sin `src`: así no hay
      nada que cargar y la comprobación de recursos de terceros sigue teniendo sentido.

      Si el servidor no contesta, no pasa nada: `sendBeacon` no espera respuesta y el try/catch se
      come el resto. Ninguna visita se pierde por lentitud, y ninguna página se rompe por esto.

      La URL entra montada entera y no como `servidor + '/v1/visita'`: así aparece literal en el
      HTML publicado y se puede comprobar de un vistazo —y automáticamente— a dónde va esto.
    */}
    <script is:inline define:vars={{ medicion: `${servidor}/v1/visita` }}>
      try {
        navigator.sendBeacon(
          medicion,
          // `text/plain` a propósito: así es una petición simple y el navegador no manda antes un
          // preflight que retrasaría la medida (el Worker lo acepta igual, pero sobra).
          new Blob([JSON.stringify({ ruta: location.pathname, referrer: document.referrer })], {
            type: 'text/plain',
          })
        )
      } catch {}
    </script>
  </body>
</html>
