---
import '../styles/global.css'
import { absoluteUrl, site, url } from '../lib/site'

interface Props {
  /** Título de la pestaña. Por defecto, el de `02` §6. */
  title?: string
  description?: string
  /** Titular del hero: Open Graph usa el mismo texto (CA-META-3). */
  ogTitle?: string
  /**
   * Fotograma de la demo con el texto ya pegado, 1200×630 (CA-META-4).
   * Todavía no existe: llega con la sección de demo. Hasta entonces no se emite
   * la etiqueta, mejor que apuntar a un archivo que no está.
   */
  ogImage?: string
  ogImageAlt?: string
  /** Ruta canónica de la página, con base aplicado. */
  path?: string
}

const {
  title = site.title,
  description = site.description,
  ogTitle = title,
  ogImage,
  ogImageAlt,
  path = '/',
} = Astro.props

const canonical = absoluteUrl(path)
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      Versión de prueba: fuera de los buscadores hasta que haya lanzamiento aprobado.
      Quitar este `noindex` y desbloquear robots.txt es una decisión humana, no del equipo.
    -->
    <meta name="robots" content="noindex, nofollow" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="echo" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={absoluteUrl(ogImage)} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />

    <slot name="head" />
  </head>
  <body class="min-h-screen bg-white text-neutral-900 antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-neutral-900 focus:px-4 focus:py-2 focus:text-white"
    >
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
