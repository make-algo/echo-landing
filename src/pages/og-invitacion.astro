---
import '../styles/global.css'

/**
 * Fotograma fijo de 1200×630 para `public/og-invitacion.png` (MAK-264). Igual que `og.astro`
 * —no es una página de la landing, no lleva `<Base>`, no entra en el sitemap ni en la navegación—
 * pero con su propio mensaje: lo que ve quien recibe el enlace de invitación antes de abrirlo, así
 * que dice el descuento en vez del titular genérico de la portada. `scripts/generar-og.mjs`
 * captura esta ruta con Playwright y guarda `public/og-invitacion.png`.
 *
 * Mismos tokens que `og.astro`: papel, tinta y el rojo de la corrección como única pieza gráfica.
 */
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
      }
      .frame {
        width: 1200px;
        height: 630px;
        box-sizing: border-box;
        background: var(--color-paper);
        color: var(--color-ink);
        font-family: var(--font-sans);
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 96px;
        position: relative;
        overflow: hidden;
      }
      .frame::before {
        content: '';
        position: absolute;
        left: 64px;
        top: 96px;
        bottom: 96px;
        width: 6px;
        background: var(--color-accent);
      }
      .marca {
        font: 500 28px/1 var(--font-mono);
        letter-spacing: -0.02em;
        color: var(--color-ink);
      }
      .descuento {
        margin-top: 40px;
        font: 500 32px/1.3 var(--font-mono);
        color: var(--color-accent);
      }
      h1 {
        margin: 20px 0 0;
        font-size: 64px;
        line-height: 1.1;
        font-weight: 600;
        letter-spacing: -0.02em;
        max-width: 20ch;
      }
      p {
        margin: 32px 0 0;
        font-size: 30px;
        line-height: 1.4;
        color: var(--color-ink-2);
        max-width: 34ch;
      }
    </style>
  </head>
  <body>
    <div class="frame">
      <p class="marca">echo</p>
      <p class="descuento">3 € de descuento en tu primer cobro</p>
      <h1>Te invita alguien que ya usa echo.</h1>
      <p>Dictado para Mac. Transcripción local, pulido con tu Claude o ChatGPT.</p>
    </div>
  </body>
</html>
