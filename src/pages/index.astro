---
import Base from '../layouts/Base.astro'
import Escrito from '../components/demo/Escrito.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import Icono from '../components/Icono.astro'
import WaitlistForm from '../components/WaitlistForm.astro'
import { url } from '../lib/site'
import {
  apertura,
  beta,
  comparativa,
  correccion,
  demo,
  dondeSePega,
  pasos,
  preguntas,
  privacidad,
  velocidad,
  vocabulario,
} from '../content/copy'
import '../styles/correccion.css'

/**
 * La landing: la página es una galerada que se limpia sola según bajas
 * (dirección B, propagada a la raíz en MAK-85 por decisión de Álvaro en
 * MAK-71, con el pulido de `docs/design/pulido-correccion-mak85.md`).
 *
 * Lo que dijiste, en negro pesadísimo y a cuerpo de cartel, tachado y corregido
 * en rojo delante de ti; y debajo, lo que queda escrito. La densidad de marcas
 * baja con el scroll —apertura destrozada, cuatro correcciones en la
 * comparativa, cierre y alta limpios— así que la página hace mientras la lees lo
 * que el producto hace con tu texto.
 *
 * Las dos capas sucias van `aria-hidden` y llevan su rótulo: en voz alta se lee
 * el copy aprobado entero, seguido y en orden, sin una sola tachadura de por
 * medio. El tachado en sí se mide, no se estima: ver `correccion/tachado.ts`.
 */
const v = correccion
const titular = apertura.titular.join(' ')
const [tecleando, hablando] = velocidad.filas

/**
 * Fase de tecleo del ciclo (MAK-129): el texto en bruto se revela carácter a
 * carácter en vez de pegarse de golpe (mak-113 §2 revertido para esta fase
 * por instrucción explícita de Álvaro, ver mak-128). Cada carácter va en su
 * propio span para poder revelarlo con opacidad sin reflow (CLS 0): el bloque
 * ya ocupa su tamaño final desde el primer fotograma. El orden y el texto son
 * los mismos que ya aprobó Álvaro, solo se envuelve carácter a carácter.
 */
function letras(texto: string) {
  return Array.from(texto)
    .map((c) => {
      const seguro = c === '&' ? '&amp;' : c === '<' ? '&lt;' : c === '>' ? '&gt;' : c
      return `<span class="cc">${seguro}</span>`
    })
    .join('')
}
const segmentosCiclo = [
  { texto: 'eh…', clase: 'ciclo__tach', delay: '0s' },
  { texto: ' hablas y aparece escrito', clase: null },
  { texto: ', o sea', clase: 'ciclo__tach', delay: '.5s' },
  { texto: ', sin muletillas, ', clase: null },
  { texto: 'sin ir diciendo coma, punto,', clase: 'ciclo__tach', delay: '1s' },
  { texto: v.insercion, clase: 'ciclo__ins', delay: '1.2s' },
  { texto: ' ', clase: null },
  { texto: 'y eh,', clase: 'ciclo__tach', delay: '1.6s' },
  { texto: ' sin cambiar de idioma', clase: null },
] as const
const cicloTextoHTML = segmentosCiclo
  .map((s) =>
    s.clase ? `<span class="${s.clase}" style="--d: ${s.delay}">${letras(s.texto)}</span>` : letras(s.texto)
  )
  .join('')
---

<Base ogTitle={titular} ogImage="/og.png" ogImageAlt="echo, dictado para Mac que escribe limpio">
  <Header />
  <main id="contenido" class="ruta-correccion">
    {/* ACTO 1 · máxima densidad de marcas */}
    <section class="acto" style="padding-top: clamp(1rem, 2vw, 2rem)">
      <span class="banda" aria-hidden="true"></span>
      <div class="apertura">
        <div>
          <p class="rubric">{v.capaSucia}</p>
          <p class="sucio" aria-hidden="true">
            <span class="tach">eh…</span> hablas y aparece escrito<span class="tach">, o sea</span>,
            sin muletillas, <span class="tach">sin ir diciendo coma, punto,</span><span class="ins"
              >{v.insercion}</span
            > <span class="tach">y eh,</span> sin cambiar de idioma
          </p>

          <div class="regla" aria-hidden="true"></div>

          <p class="rubric">{v.capaLimpia}</p>
          <h1>{titular}</h1>
          {/* MAK-230: qué es esto, en grande, inmediatamente debajo del
               bloque limpio. MAK-244: el subtítulo se quita — este tagline
               es lo único que queda de esa línea en el hero. */}
          <p class="tagline">{apertura.tagline}</p>
          <p><a class="btn" href={url('/descarga')}>{apertura.cta}</a></p>
          <p class="c-dim" style="margin-top: 1.25rem">
            {apertura.requisito.aviso.map((t) => (t.dato ? <strong>{t.texto}</strong> : t.texto))}{' '}{apertura.requisito.maquina}
          </p>
        </div>

        {/* La columna del producto: la demo (decorativa, aria-hidden) y,
             debajo, la comparación de velocidad — que SÍ se lee. Las dos
             comparten columna porque ahí sobra alto que el texto de la
             izquierda ya no tiene (MAK-230): así la comparación entra por
             encima del pliegue en escritorio sin alargar la columna de
             texto ni empujar el bloque de corrección fuera de vista. */}
        <div class="apertura__col-prod">
          {/* El producto, en el primer pantallazo. Una página que promete
               «hablas y aparece escrito» no puede enseñar cero: se ve dictarse,
               corregirse y pegarse solo, en bucle, sin esperar al scroll
               (MAK-113). `<Escrito />` es el fotograma final del ciclo — su
               marcado no cambia, solo se le superpone el bruto mientras dicta. */}
          <div class="apertura__prod ciclo" aria-hidden="true">
            <div class="ciclo__bruto win">
              <div class="win__bar">{demo.ventana.barra}</div>
              <div class="win__field win__field--to">
                <b>{demo.ventana.para.etiqueta}</b> {demo.ventana.para.valor}
              </div>
              <div class="win__field"><b>{demo.ventana.asunto.etiqueta}</b> {demo.ventana.asunto.valor}</div>
              <div class="win__rule"></div>
              <div class="win__body">
                <span class="ciclo__caret"></span><span class="ciclo__texto" set:html={cicloTextoHTML} />
              </div>
            </div>
            <div class="ciclo__final">
              <Escrito />
            </div>
          </div>

          {/* MAK-229: la píldora real, junto al bloque de dictado en bruto de
               arriba — lo que el visitante ve de verdad en su pantalla
               mientras habla. A diferencia del `.ciclo` de encima, esta capa
               NO va `aria-hidden`: es la prueba del producto, no una
               recreación, así que lleva su propio `alt`. Pixels reales de la
               app (MAK-228), redimensionados y comprimidos por
               `scripts/generar-producto.mjs`; nunca se recorta a mano. */}
          <div class="apertura__pildora">
            <picture>
              <source srcset={url('/producto/hud_listening.avif')} type="image/avif" />
              <source srcset={url('/producto/hud_listening.webp')} type="image/webp" />
              <img
                src={url('/producto/hud_listening.png')}
                width="320"
                height="137"
                alt="La píldora de echo escuchando, con la onda de voz y el contador en 0:07."
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </div>

          {/* MAK-230: el «4 veces más rápido» como pieza visual, no como
               frase enterrada — dos filas en el mismo lenguaje de corrección
               que ya usa la página. «Tecleando» lleva el tachado medido de
               `correccion/tachado.ts` (clase `.tach`, la misma que arriba);
               ninguna de las dos filas va `aria-hidden`: son la comparación
               en sí, no una capa sucia que repita lo que ya dijo el titular.
               `.tach` va en el `<span>` interno, inline, no en `.veloc__valor`
               (que es `display: block` para la maquetación): `tachado.ts` mide
               con `getClientRects()`, que da un rect por línea SOLO en línea
               —sobre un bloque da un único rect, el de toda la caja, y el
               trazo sale mal (ver revisión de la issue). */}
          <div class="veloc">
            <p class="veloc__fila">
              <span class="veloc__modo">{tecleando.modo}</span>
              <span class="veloc__valor"><span class="tach">{tecleando.ppm}</span></span>
            </p>
            <p class="veloc__fila">
              <span class="veloc__modo">{hablando.modo}</span>
              <span class="veloc__valor veloc__valor--bien">{hablando.ppm}</span>
            </p>
            <p class="microcopy" style="margin-top: 0.6rem">{velocidad.fuente}</p>
          </div>
        </div>
      </div>
    </section>

    {/* ACTO 2 · «Se pega donde ya escribes» (MAK-194/195). La spec la pide
         entre el Hero y la Demo animada, pero en esta dirección (galerada,
         MAK-85) las dos ya son UNA sola sección: el ciclo de dictado vive
         dentro del hero para que compartan el primer viewport en escritorio
         (D3 de `03-alcance-landing.md`, no se reabre aquí). Partirlas para
         cumplir la letra de la spec rompería esa regla ya fijada, así que la
         franja va inmediatamente después del hero+demo — la misma posición
         argumental, generalizando la promesa antes de que el resto de la
         página la concrete. Decisión anotada en la issue, no en silencio. */}
    <section class="acto" id="donde-se-pega" style="margin-top: clamp(3.5rem, 8vw, 7rem)">
      <h2>{dondeSePega.titulo}</h2>
      <ul class="carrusel" style="margin-top: 1.5rem">
        {
          dondeSePega.piezas.map((p) => (
            <li class="carrusel__pieza">
              <Icono nombre={p.icono} />
              <span class="carrusel__etiqueta">{p.etiqueta}</span>
            </li>
          ))
        }
      </ul>
      <p class="c-lead" style="margin-top: 1.5rem">{dondeSePega.cuerpo}</p>
    </section>

    {/* ACTO 3 · las marcas empiezan a escasear: una barra de margen y nada más */}
    <section class="acto" style="margin-top: clamp(3.5rem, 8vw, 7rem)">
      <span class="banda" aria-hidden="true"></span>
      <h2 class="rubric" id="como-funciona">{pasos.rotulo}</h2>
      <ol style="list-style: none; padding: 0; display: grid; gap: 1.25rem; margin-top: 1.25rem">
        {
          pasos.lista.map((paso) => (
            <li>
              <span class="c-dim" aria-hidden="true">{paso.n}</span>
              <h3>{paso.titulo}</h3>
              <p style="margin-top: 0.3rem; color: var(--c-ink-2)">
                {paso.partes.map((t) => (t.dato ? <strong>{t.texto}</strong> : t.texto))}
              </p>
              {/* MAK-229: «Puliendo con Claude…» en el píxel de la app — la
                   única prueba visual de que el pulido corre contra la
                   suscripción que el visitante ya paga. Solo en este paso
                   (identidad por referencia contra `pasos.lista[1]`, no por
                   índice suelto: si el orden de los pasos cambia, esto se
                   mueve con «Se pule con tu suscripción.»). Carga perezosa:
                   este paso no está en el primer pantallazo. */}
              {paso === pasos.lista[1] && (
                <picture class="paso__pildora">
                  <source srcset={url('/producto/hud_polishing.avif')} type="image/avif" />
                  <source srcset={url('/producto/hud_polishing.webp')} type="image/webp" />
                  <img
                    src={url('/producto/hud_polishing.png')}
                    width="280"
                    height="119"
                    alt="La píldora de echo con la onda terracota, un icono de chispas y el texto «Puliendo con Claude…»."
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    {/* ACTO 3bis · «Vocabulario personal» (MAK-194/195), entre «Cómo funciona»
         (#como-funciona, el h2 de arriba) y «Comparación» (#comparacion,
         siguiente acto). Mismo patrón que privacidad/para-quién: rótulo mono
         + un párrafo. */}
    <section class="acto" id="vocabulario" style="margin-top: clamp(3.5rem, 8vw, 7rem)">
      <h2 class="rubric">{vocabulario.titulo}</h2>
      <p class="c-lead" style="color: var(--c-ink); margin-top: 1rem">
        {vocabulario.cuerpo.map((s) => (s.enfasis ? <em>{s.texto}</em> : s.texto))}
      </p>
    </section>

    {/* ACTO 4 · cuatro correcciones, ni una más. */}
    <section class="acto" style="margin-top: clamp(4rem, 9vw, 8rem)">
      <div class="regla" aria-hidden="true"></div>
      <h2 id="comparacion">{comparativa.titulo}</h2>
      <p class="c-lead">{comparativa.entradilla}</p>

      <div style="margin-top: 2rem">
        {
          comparativa.filas.map((fila) => (
            <div class="corr" data-fila-comparativa>
              <p class="crit">{fila.criterio}</p>
              <p>
                <span class="sr-only">{comparativa.columnas.macos}: </span>
                <span class="mal tach">{fila.macos}</span>
              </p>
              <p class="bien">
                <span class="sr-only">{comparativa.columnas.echo}: </span>{fila.echo}
              </p>
              {/* MAK-245: el ejemplo del deploy, rescatado de la sección
                   «Qué hace distinto» al borrarla — único sitio del copy
                   donde vivía. */}
              {'nota' in fila && <p class="microcopy" style="margin-top: 0.5rem">{fila.nota}</p>}
            </div>
          ))
        }
      </div>
    </section>

    {/* ACTO 5 · cero marcas. La página ya está limpia. */}
    <section class="acto" style="margin-top: clamp(4rem, 9vw, 8rem)">
      <p class="final">
        {comparativa.cierre.concesion} {comparativa.cierre.afirmacion}
      </p>
      {/* MAK-251: tras el cierre de la comparativa no quedaba más CTA que la
           cabecera pegajosa. Mismo botón y misma línea de condiciones del
           héroe, sin copy nuevo. */}
      <p style="margin-top: 1.5rem"><a class="btn" href={url('/descarga')}>{apertura.cta}</a></p>
      <p class="c-dim" style="margin-top: 1.25rem">
        {apertura.requisito.aviso.map((t) => (t.dato ? <strong>{t.texto}</strong> : t.texto))}{' '}{apertura.requisito.maquina}
      </p>
    </section>

    <section class="acto" style="margin-top: clamp(3.5rem, 8vw, 7rem)">
      <h2 class="rubric">{privacidad.rotulo}</h2>
      <p class="c-lead" style="color: var(--c-ink); margin-top: 1rem">{privacidad.principal}</p>
    </section>

    {/* ACTO 6 · el alta, en el mismo sistema y sin una sola caja */}
    <section class="acto" id="beta" style="margin-top: clamp(4rem, 9vw, 8rem)">
      <div class="regla" aria-hidden="true"></div>
      <h2>{beta.titulo}</h2>
      <p class="c-lead">{beta.entradilla}</p>
      <WaitlistForm />
    </section>

    {/* El lado derecho lleva su propia nota de margen: la última pregunta
         antes del cierre limpio (MAK-85, punto 2.4). */}
    <section
      class="acto acto--margen"
      id="preguntas"
      style="margin-top: clamp(3.5rem, 8vw, 7rem); padding-bottom: clamp(3rem, 7vw, 6rem)"
    >
      <div class="acto__cuerpo">
        <h2 class="rubric">{preguntas.rotulo}</h2>
        <div class="faq" style="margin-top: 1.25rem">
          {
            preguntas.lista.map((q) => (
              <details class="qa">
                <summary>{q.p}</summary>
                <p>{q.r}</p>
              </details>
            ))
          }
        </div>
      </div>
      <p class="margen">{v.margenPreguntas}</p>
    </section>
  </main>

  <Footer />
</Base>

<script>
  import { iniciarTachado } from '../components/correccion/tachado'
  import { iniciarFaq } from '../components/correccion/faq'
  import { iniciarCiclo } from '../components/correccion/ciclo'

  const contenido = document.getElementById('contenido')
  if (contenido) {
    iniciarTachado(contenido)
    iniciarFaq(contenido)
  }
  const ciclo = document.querySelector<HTMLElement>('.ciclo')
  if (ciclo) iniciarCiclo(ciclo)
</script>
