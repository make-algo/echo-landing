---
import Base from '../layouts/Base.astro'
import Demo from '../components/Demo.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import Argumentos from '../components/secciones/Argumentos.astro'
import Beta from '../components/secciones/Beta.astro'
import ComparativaTabla from '../components/secciones/ComparativaTabla.astro'
import ParaQuien from '../components/secciones/ParaQuien.astro'
import Pasos from '../components/secciones/Pasos.astro'
import Preguntas from '../components/secciones/Preguntas.astro'
import Privacidad from '../components/secciones/Privacidad.astro'
import { apertura } from '../content/copy'

/**
 * El control: las diez secciones de la landing, en su orden definitivo.
 *
 * Todo el texto visible sale de `src/content/copy.ts` y va literal; esta página
 * decide la composición, no las palabras. `/a/`, `/b/` y `/c/` reordenan la
 * misma fuente con otra idea organizadora y heredan de aquí los componentes de
 * sección.
 */
const ogTitle = apertura.titular.join(' ')
---

<Base ogTitle={ogTitle}>
  <Header />

  <main id="contenido">
    <!-- 1 + 2 · El titular ocupa el ancho de página; hero y demo se reparten
         debajo a partir de 1024 px. El orden del DOM no cambia con el ancho. -->
    <div class="first wrap">
      <div class="first__grid">
        <h1>
          {apertura.titular[0]}<br class="wide" /> {apertura.titular[1]}<br class="wide" /> {
            apertura.titular[2]
          }
        </h1>

        <div class="hero__rest">
          <p class="lead hero__sub">{apertura.subtitulo}</p>
          <p class="hero__cta"><a class="btn" href="#beta">{apertura.cta}</a></p>
          <p class="hero__req">
            {apertura.requisito.aviso}<span class="sep"> · </span><br class="br" />{
              apertura.requisito.maquina
            }
          </p>
        </div>

        <Demo />
      </div>
    </div>

    <Argumentos />
    <Pasos />
    <ComparativaTabla />
    <Privacidad />
    <ParaQuien />
    <Beta />
    <Preguntas />
  </main>

  <!-- 10 · Pie -->
  <Footer />
</Base>
