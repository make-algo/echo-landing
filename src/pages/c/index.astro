---
import Base from '../../layouts/Base.astro'
import Dicho from '../../components/demo/Dicho.astro'
import Escrito from '../../components/demo/Escrito.astro'
import Footer from '../../components/Footer.astro'
import WaitlistForm from '../../components/WaitlistForm.astro'
import '../../styles/variante-editor.css'
import {
  apertura,
  argumentos,
  beta,
  comparativa,
  demo,
  paraQuien,
  pasos,
  preguntas,
  privacidad,
  variantes,
} from '../../content/copy'

/**
 * /c/ — EDITOR. La página es un búfer de texto abierto en un editor.
 * Pulido de la ronda final (MAK-82): ver `docs/design/pulido-editor-mak82.md`.
 *
 * Lo que salva esta dirección del tópico «landing con estética de terminal» es
 * que el formulario y las preguntas están DE VERDAD dentro del búfer: el alta
 * se escribe en una línea con su marca de entrada y las preguntas se despliegan
 * como plegado de código real —con teclado, `aria-expanded` y un contador de
 * líneas que es una medida, no un adorno—.
 *
 * Y el canal de numeración no miente: cada `.ln-num` lo cuenta
 * `src/components/editor/numeracion.ts` MIDIENDO su alto real dividido por su
 * propio interlineado, nunca adivinando un ancho de columna. El detalle está
 * en ese fichero.
 */
const titular = apertura.titular.join(' ')
const v = variantes.editor
---

<Base ogTitle={titular} path="/c/">
  <main id="contenido" class="ruta-editor">
    <div class="buf" id="buf">
      <p class="ln-num com">{v.comentarios.cabecera}</p>
      <p class="ln-num com vacia">&nbsp;</p>

      <h1 class="ln-num">{titular}</h1>
      <p class="ln-num com vacia">&nbsp;</p>
      <p class="ln-num txt i1">{apertura.subtitulo}</p>
      <p class="ln-num com vacia">&nbsp;</p>
      <p class="ln-num i1"><a class="sel-cta" href="#beta">{apertura.cta}</a></p>
      <p class="ln-num txt i1">{apertura.requisito.aviso} {apertura.requisito.maquina}</p>
      <p class="ln-num com vacia">&nbsp;</p>

      <!-- LA DEMO, pieza central: el panel oscuro y la ventana clara separados
           para que se lean como antes → después. `data-fijo`: es un objeto
           incrustado, no texto que fluye, así que cuenta como una sola línea
           por alto que renderice. -->
      <p class="ln-num com">{v.comentarios.demo}</p>
      <figure class="ln-num i1 demo-anim" id="demo" data-fijo>
        <h2 class="sr-only">{demo.tituloOculto}</h2>
        <p class="sr-only">{demo.descripcion}</p>
        <div class="demo-par">
          <Dicho />
          <Escrito />
        </div>
      </figure>
      <p class="ln-num txt i1">{demo.pie}</p>
      <p class="ln-num com vacia">&nbsp;</p>

      <p class="ln-num com">{argumentos.rotulo.toLowerCase()}</p>
      {
        argumentos.lista.map((a) => (
          <>
            <h3 class="ln-num i1">{a.titulo}</h3>
            <p class="ln-num txt i2">{a.texto}</p>
            <p class="ln-num com vacia">&nbsp;</p>
          </>
        ))
      }

      <p class="ln-num com">{pasos.rotulo.toLowerCase()}</p>
      {
        pasos.lista.map((paso) => (
          <>
            <h3 class="ln-num i1">{paso.titulo}</h3>
            <p class="ln-num txt i2">
              {paso.partes.map((t) => (t.dato ? <strong>{t.texto}</strong> : t.texto))}
            </p>
          </>
        ))
      }
      <p class="ln-num com vacia">&nbsp;</p>

      <!-- LA COMPARATIVA ES UN DIFF. El signo lleva el significado, no el
           color: funciona en monocromo y para quien no distingue colores. -->
      <p class="ln-num com" id="comparacion">{v.comentarios.comparativa}</p>
      <h2 class="ln-num">{comparativa.titulo}</h2>
      <p class="ln-num txt i1">{comparativa.entradilla}</p>
      <p class="ln-num com vacia">&nbsp;</p>
      {
        comparativa.filas.map((fila) => (
          <>
            <p class="ln-num hunk" data-fila-comparativa>
              @@ {fila.criterio} @@
            </p>
            <p class="ln-num dl dl--del">
              <span aria-hidden="true">−</span>
              <span class="v2">
                <span class="sr-only">{comparativa.columnas.macos}: </span>
                {fila.macos}
              </span>
            </p>
            <p class="ln-num dl dl--add">
              <span aria-hidden="true">+</span>
              <span class="v2">
                <span class="sr-only">{comparativa.columnas.echo}: </span>
                {fila.echo}
              </span>
            </p>
          </>
        ))
      }
      <p class="ln-num com vacia">&nbsp;</p>

      <h2 class="ln-num">{comparativa.cierre.concesion} {comparativa.cierre.afirmacion}</h2>
      <p class="ln-num com vacia">&nbsp;</p>

      <p class="ln-num com" id="privacidad">{privacidad.rotulo.toLowerCase()}</p>
      <p class="ln-num txt i1">{privacidad.principal}</p>
      <p class="ln-num com vacia">&nbsp;</p>
      {privacidad.notas.map((n) => <p class="ln-num txt i1">{n}</p>)}
      <p class="ln-num com vacia">&nbsp;</p>

      <p class="ln-num com">{paraQuien.rotulo.toLowerCase()}</p>
      {
        paraQuien.parrafos.map((p) => (
          <p class="ln-num txt i1">
            <strong>{p.fuerte}</strong>
            {p.resto}
          </p>
        ))
      }
      <p class="ln-num com vacia">&nbsp;</p>

      <!-- LAS PREGUNTAS SON PLEGADO DE CÓDIGO, no un acordeón: cada una es un
           <details> real, con teclado y `aria-expanded` sincronizado por el
           script de más abajo. El contador «N líneas» de cada etiqueta plegada
           es la misma medida que usa el canal, calculada al vuelo. -->
      <p class="ln-num com" id="preguntas">{v.comentarios.preguntas}</p>
      <div class="faq">
        {
          preguntas.lista.map((q) => (
            <details class="qa" open={q.p === '¿Se envía mi voz a algún sitio?' || undefined}>
              <summary class="ln-num">
                <span class="tri" aria-hidden="true">▸</span>
                <span class="q">{q.p}</span>
              </summary>
              <p class="ln-num txt i1">{q.r}</p>
            </details>
          ))
        }
      </div>
      <p class="ln-num com vacia">&nbsp;</p>

      <!-- EL ALTA ES ESCRIBIR EN EL BÚFER. Ni una sola caja. -->
      <p class="ln-num com" id="beta">{beta.titulo.toLowerCase()}</p>
      <p class="ln-num txt i1">{beta.entradilla}</p>
      <p class="ln-num com vacia">&nbsp;</p>
      <WaitlistForm />
    </div>
  </main>

  <Footer />

  <!-- La barra de estado, con valores reales: el fichero, los dos idiomas que
       echo mezcla dentro de una frase, y los atajos que de verdad funcionan. -->
  <div class="ruta-editor ruta-editor-barra" aria-hidden="true">
    <span>{v.barra.fichero}</span>
    <span class="oculta">{v.barra.idiomas}</span>
    <span class="sp at"><kbd>{v.atajos.ir}</kbd> <kbd>{v.atajos.comparativa}</kbd> comparativa</span>
    <span class="at"><kbd>{v.atajos.ir}</kbd> <kbd>{v.atajos.beta}</kbd> beta</span>
  </div>
</Base>

<script>
  import { iniciarNumeracion } from '../../components/editor/numeracion'

  const buf = document.getElementById('buf')
  if (buf) iniciarNumeracion(buf)

  // El plegado de cada pregunta es un <details> nativo: el clic y el teclado
  // (Tab, Enter, Espacio) ya funcionan solos. Lo único que el navegador no da
  // gratis es `aria-expanded` reflejado como atributo del <summary>, así que
  // se sincroniza aquí, y con él el triángulo — el mismo estado, dos señales.
  for (const detalles of document.querySelectorAll('details.qa')) {
    const resumen = detalles.querySelector('summary')
    const tri = detalles.querySelector('.tri')
    const sincronizar = () => {
      resumen?.setAttribute('aria-expanded', String(detalles.open))
      if (tri) tri.textContent = detalles.open ? '▾' : '▸'
    }
    detalles.addEventListener('toggle', sincronizar)
    sincronizar()
  }

  // Atajos de editor: `g` y luego `c` o `b`. No son el único camino a ningún
  // sitio —el CTA y el scroll siguen ahí— y se callan mientras escribes.
  let esperando = 0
  addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement | null
    if (e.metaKey || e.ctrlKey || e.altKey) return
    if (t?.closest('input, textarea, select, [contenteditable]')) return
    if (e.key === 'g') {
      esperando = Date.now()
      return
    }
    if (Date.now() - esperando > 1000) return
    const destino = e.key === 'c' ? '#comparacion' : e.key === 'b' ? '#beta' : ''
    if (!destino) return
    esperando = 0
    const el = document.querySelector<HTMLElement>(destino)
    if (!el) return
    el.scrollIntoView()
    // El teclado va detrás del scroll: si no, el siguiente tabulador devuelve
    // al visitante al principio de la página.
    el.setAttribute('tabindex', '-1')
    el.focus({ preventScroll: true })
  })
</script>
