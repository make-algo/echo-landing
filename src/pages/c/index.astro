---
import Base from '../../layouts/Base.astro'
import Dicho from '../../components/demo/Dicho.astro'
import Escrito from '../../components/demo/Escrito.astro'
import Footer from '../../components/Footer.astro'
import Lineas from '../../components/editor/Lineas.astro'
import WaitlistForm from '../../components/WaitlistForm.astro'
import {
  apertura,
  argumentos,
  beta,
  comparativa,
  demo,
  paraQuien,
  pasos,
  preguntas,
  privacidad,
  variantes,
} from '../../content/copy'
import { lineas } from '../../lib/lineas'
import '../../styles/variante-editor.css'

/**
 * /c/ — EDITOR. La página es un búfer de texto abierto en un editor.
 *
 * Lo que salva esta dirección del tópico «landing con estética de terminal» es
 * que el formulario y las preguntas están DE VERDAD dentro del búfer: el alta se
 * escribe en una línea con su marca de entrada, y las preguntas se despliegan
 * como plegado de código con su marca de líneas plegadas. Si eso se afloja, la
 * dirección no se rescata.
 *
 * Y el canal de numeración no miente: el texto va partido en líneas de origen y
 * cada número señala una. Los cortes del titular los decidimos nosotros —el copy
 * es literal, los cortes son nuestros—, así que un titular de cuatro renglones
 * son cuatro líneas numeradas.
 */
const v = variantes.editor
const titular = apertura.titular.join(' ')
/** Cuántas líneas ocupa cada respuesta plegada. El número es real. */
const plegadas = preguntas.lista.map((q) => lineas(q.r).length)
---

<Base ogTitle={titular} path="/c/">
  <main id="contenido" class="ruta-editor">
    <div class="buf">
      <div class="l"><p class="com">{v.comentarios.cabecera}</p></div>
      <div class="l l--vacia"><p></p></div>

      <Lineas texto={titular} como="h1" ancho={30} />
      <div class="l l--vacia"><p></p></div>
      <Lineas texto={apertura.subtitulo} clase="txt i1" />
      <div class="l l--vacia"><p></p></div>
      <div class="l i1"><p><a class="sel-cta" href="#beta">{apertura.cta}</a></p></div>
      <div class="l l--vacia"><p></p></div>
      <Lineas
        texto={`${apertura.requisito.aviso} ${apertura.requisito.maquina}`}
        clase="txt i1"
      />
      <div class="l l--vacia"><p></p></div>

      <!-- LA DEMO, pieza central: el panel oscuro y la ventana clara separados
           para que se lean como antes → después. -->
      <div class="l"><p class="com">{v.comentarios.demo}</p></div>
      <figure class="l i1 demo-anim" id="demo">
        <div>
          <h2 class="sr-only">{demo.tituloOculto}</h2>
          <p class="sr-only">{demo.descripcion}</p>
          <div class="demo-par">
            <Dicho />
            <Escrito />
          </div>
        </div>
      </figure>
      <Lineas texto={demo.pie} clase="txt i1" />
      <div class="l l--vacia"><p></p></div>

      <div class="l"><p class="com">{argumentos.rotulo.toLowerCase()}</p></div>
      {
        argumentos.lista.map((a) => (
          <>
            <div class="l i1"><h3>{a.titulo}</h3></div>
            <Lineas texto={a.texto} clase="txt i2" />
            <div class="l l--vacia"><p></p></div>
          </>
        ))
      }

      <div class="l"><p class="com">{pasos.rotulo.toLowerCase()}</p></div>
      {
        pasos.lista.map((paso) => (
          <>
            <div class="l i1">
              <h3><span class="com" aria-hidden="true">{paso.n} </span>{paso.titulo}</h3>
            </div>
            <Lineas
              texto={paso.partes.map((t) => t.texto).join('')}
              clase="txt i2"
            />
          </>
        ))
      }
      <div class="l l--vacia"><p></p></div>

      <!-- LA COMPARATIVA ES UN DIFF. El signo lleva el significado, no el
           color: funciona en monocromo y para quien no distingue colores. -->
      <div class="l" id="comparacion"><p class="com">{v.comentarios.comparativa}</p></div>
      <Lineas texto={comparativa.titulo} como="h2" ancho={40} />
      <Lineas texto={comparativa.entradilla} clase="txt i1" />
      <div class="l l--vacia"><p></p></div>
      {
        comparativa.filas.map((fila) => (
          <>
            <div class="l" data-fila-comparativa>
              <p class="hunk">@@ {fila.criterio} @@</p>
            </div>
            <div class="l">
              <p class="dl dl--del">
                <span aria-hidden="true">−</span>
                <span class="v2"><span class="sr-only">{comparativa.columnas.macos}: </span>{fila.macos}</span>
              </p>
            </div>
            <div class="l">
              <p class="dl dl--add">
                <span aria-hidden="true">+</span>
                <span class="v2"><span class="sr-only">{comparativa.columnas.echo}: </span>{fila.echo}</span>
              </p>
            </div>
          </>
        ))
      }
      <div class="l l--vacia"><p></p></div>

      <Lineas
        texto={`${comparativa.cierre.concesion} ${comparativa.cierre.afirmacion}`}
        como="h2"
        ancho={44}
      />
      <div class="l l--vacia"><p></p></div>

      <div class="l" id="privacidad"><p class="com">{privacidad.rotulo.toLowerCase()}</p></div>
      <Lineas texto={privacidad.principal} clase="txt i1" />
      <div class="l l--vacia"><p></p></div>
      {privacidad.notas.map((n) => <Lineas texto={n} clase="txt i1" />)}
      <div class="l l--vacia"><p></p></div>

      <div class="l"><p class="com">{paraQuien.rotulo.toLowerCase()}</p></div>
      {
        paraQuien.parrafos.map((p) => (
          <>
            <Lineas texto={`${p.fuerte}${p.resto}`} clase="txt i1" />
            <div class="l l--vacia"><p></p></div>
          </>
        ))
      }

      <!-- LAS PREGUNTAS SON PLEGADO DE CÓDIGO, no un acordeón. -->
      <div class="l" id="preguntas"><p class="com">{v.comentarios.preguntas}</p></div>
      <div class="faq">
        {
          preguntas.lista.map((q, i) => (
            <details class="qa">
              <summary class="l"><span class="q" data-lineas={plegadas[i]}>{q.p}</span></summary>
              <Lineas texto={q.r} clase="txt i1" />
            </details>
          ))
        }
      </div>
      <div class="l l--vacia"><p></p></div>

      <!-- EL ALTA ES ESCRIBIR EN EL BÚFER. Ni una sola caja. -->
      <div class="l" id="beta"><p class="com">{beta.titulo.toLowerCase()}</p></div>
      <Lineas texto={beta.entradilla} clase="txt i1" />
      <div class="l l--vacia"><p></p></div>
      <WaitlistForm />
      <div class="l l--vacia"><p></p></div>
    </div>
  </main>

  <Footer />

  <!-- La barra de estado, con valores reales: el fichero, los dos idiomas que
       echo mezcla dentro de una frase, y los atajos que de verdad funcionan. -->
  <div class="ruta-editor ruta-editor-barra" aria-hidden="true">
    <span>{v.barra.fichero}</span>
    <span class="oculta">{v.barra.idiomas}</span>
    <span class="sp at"><kbd>{v.atajos.ir}</kbd> <kbd>{v.atajos.comparativa}</kbd> comparativa</span>
    <span class="at"><kbd>{v.atajos.ir}</kbd> <kbd>{v.atajos.beta}</kbd> beta</span>
  </div>
</Base>

<script>
  // Atajos de editor: `g` y luego `c` o `b`. No son el único camino a ningún
  // sitio —el CTA y el scroll siguen ahí— y se callan mientras escribes.
  let esperando = 0
  addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement | null
    if (e.metaKey || e.ctrlKey || e.altKey) return
    if (t?.closest('input, textarea, select, [contenteditable]')) return
    if (e.key === 'g') {
      esperando = Date.now()
      return
    }
    if (Date.now() - esperando > 1000) return
    const destino = e.key === 'c' ? '#comparacion' : e.key === 'b' ? '#beta' : ''
    if (!destino) return
    esperando = 0
    const el = document.querySelector<HTMLElement>(destino)
    if (!el) return
    el.scrollIntoView()
    // El teclado va detrás del scroll: si no, el siguiente tabulador devuelve
    // al visitante al principio de la página.
    el.setAttribute('tabindex', '-1')
    el.focus({ preventScroll: true })
  })
</script>
