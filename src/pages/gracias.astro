---
import Base from '../layouts/Base.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { url } from '../lib/site'
import { beta } from '../content/copy'

/**
 * Destino del envío sin JavaScript. Repite el bloque de éxito con «tu correo»
 * en lugar del correo, porque aquí no lo tenemos: es una página estática y el
 * dato viajó al proveedor, no a nosotros.
 */
---

<Base title="Apuntado — echo" path="/gracias">
  <Header />
  <main id="contenido" class="section">
    <div class="wrap">
      <!--
        El h1 va oculto a la vista: esta página no tiene titular propio en el
        copy aprobado, y un titular visible sería copy nuevo, que no se inventa
        aquí. Oculto le da a la página el encabezado que le faltaba sin tocar el
        diseño ni añadir una palabra visible.
      -->
      <h1 class="sr-only">Apuntado a la lista de espera de echo</h1>
      <div class="done" style="margin-top: 0">
        <p>{beta.ok.uno}<span class="mail">tu correo</span>{beta.ok.dos}</p>
        <p>{beta.ok.extra}</p>
      </div>
      <p style="margin-top: 32px"><a href={url('/')}>Volver a la página de echo</a></p>
    </div>
  </main>
  <Footer />
</Base>
