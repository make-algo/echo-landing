---
import Base from '../layouts/Base.astro'
import Footer from '../components/Footer.astro'
import { url } from '../lib/site'

/**
 * Destino del envío sin JavaScript. Repite el bloque de
 * éxito con «tu correo» en lugar del correo, porque aquí no lo tenemos: es una
 * página estática y el dato viajó al proveedor, no a nosotros.
 */
---

<Base title="Apuntado — echo" path="/gracias">
  <main id="contenido" class="section">
    <div class="wrap">
      <div class="form-card" style="min-height: auto">
        <!--
          El h1 va oculto a la vista y no en pantalla: esta página no tiene
          titular propio en el copy aprobado, y un titular visible sería copy
          nuevo, que no se inventa aquí. Oculto le da a la página el encabezado
          que le faltaba sin tocar el diseño ni añadir una palabra visible.
        -->
        <h1 class="sr-only">Apuntado a la lista de espera de echo</h1>
        <div class="done">
          <p>Apuntado. Te escribimos a <span class="mail">tu correo</span> cuando abramos tu tanda.</p>
          <p>Si quieres acelerar: cuéntanos cómo dictas hoy y qué te falla. Se lee todo.</p>
        </div>
        <p style="margin-top: 28px">
          <a href={url('/')} style="color: var(--color-accent)">Volver a la página de echo</a>
        </p>
      </div>
    </div>
  </main>
  <Footer />
</Base>
