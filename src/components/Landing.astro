---
import Base from '../layouts/Base.astro'
import Footer from './Footer.astro'
import Header from './Header.astro'
import Icono from './Icono.astro'
import { url } from '../lib/site'
import { DEFAULT_LOCALE, getCopy, type Locale } from '../i18n/copy'
import '../styles/correccion.css'

interface Props {
  lang?: Locale
}
const { lang = DEFAULT_LOCALE } = Astro.props
const {
  apertura,
  comparativa,
  contacto,
  correccion,
  dondeSePega,
  heroSucio,
  imagenes,
  meta,
  pasos,
  preguntas,
  privacidad,
  velocidad,
  video,
} = getCopy(lang)

/**
 * La landing: la página es una galerada que se limpia sola según bajas
 * (dirección B, propagada a la raíz en MAK-85 por decisión de Álvaro en
 * MAK-71, con el pulido de `docs/design/pulido-correccion-mak85.md`).
 *
 * Lo que dijiste, en negro pesadísimo y a cuerpo de cartel, tachado y corregido
 * en rojo delante de ti. La densidad de marcas baja con el scroll —apertura
 * tachada, cuatro correcciones en la comparativa, cierre y dudas limpios— así
 * que la página hace mientras la lees lo que el producto hace con tu texto.
 *
 * Una sola columna, alineada con la cabecera, y cinco bloques: apertura con
 * el vídeo, cómo funciona, comparativa, cierre con el botón y dudas. Antes la
 * apertura tenía una segunda columna (correo de ejemplo, píldora, velocidad)
 * que competía con el titular; se quitó por el feedback de primera impresión
 * en escritorio (05-10-2026).
 *
 * La capa sucia va `aria-hidden`: en voz alta se lee el copy aprobado entero,
 * seguido y en orden, sin una sola tachadura de por medio. El tachado en sí
 * se mide, no se estima: ver `correccion/tachado.ts`.
 *
 * MAK-274: componente compartido por `/` (es) y `/en/` (en)
 * — la maqueta es una sola, el idioma la parametriza.
 */
const titular = apertura.titular.join(' ')
const [tecleando, hablando] = velocidad.filas

/** MAK-243: mailto pelado, sin cuerpo prerrellenado — solo destinatario y asunto. */
const mailtoContacto = `mailto:${contacto.destino}?subject=${encodeURIComponent(contacto.asunto)}`

/** MAK-274: el selector de idioma en el pie lleva a esta misma portada en el otro idioma. */
const otroIdiomaHref = lang === 'es' ? url('/', 'en') : url('/')
---

<Base
  ogTitle={titular}
  ogImage="/og.png"
  ogImageAlt={meta.ogImageAlt}
  path="/"
  lang={lang}
  translations={{ es: '/', en: '/' }}
>
  <Header lang={lang} />
  <main id="contenido" class="ruta-correccion">
    {/* LA APERTURA · una sola columna y una sola idea: lo dicho, tachado y
         corregido a cuerpo de cartel; una línea que dice qué es; el botón.
         Debajo, el producto de verdad (el vídeo), que asoma ya en la primera
         pantalla. El `<h1>` es el titular limpio para quien no ve la página:
         a la vista, la capa sucia con sus tachones YA se lee como ese mismo
         titular, y pintarlo otra vez debajo era repetir la frase (feedback de
         la primera impresión en escritorio, 05-10-2026). */}
    <section class="acto apertura">
      <p class="sucio" aria-hidden="true">
        {
          heroSucio.segmentos.map((s) =>
            'insercion' in s && s.insercion ? (
              <span class="ins">{correccion.insercion}</span>
            ) : s.tachado ? (
              <span class="tach">{s.texto}</span>
            ) : (
              s.texto
            )
          )
        }
      </p>
      <h1 class="sr-only">{titular}</h1>
      <p class="tagline">{apertura.tagline}</p>
      <p><a class="btn" href={url('/descarga')}>{apertura.cta}</a></p>
      <p class="c-dim apertura__requisito">
        {apertura.requisito.aviso.map((t) => (t.dato ? <strong>{t.texto}</strong> : t.texto))}{' '}{apertura.requisito.maquina}
      </p>
    </section>

    {/* El vídeo demo, pegado a la apertura: el producto de verdad, con voz.
         Lo genera el repo privado (`video/`, `npm run web -- <idioma>`): la píldora
         es la de la app y los textos, lo que echo transcribió y pulió. La portada es
         el fotograma de los tachones —la misma corrección que organiza la página—.
         `preload="none"`: no se descarga nada hasta que alguien le da a reproducir.
         Sin JavaScript quedan los controles nativos; con él, el botón rojo.

         Debajo, como pie del vídeo, la comparación de velocidad (MAK-230): ya no
         compite con el titular en una segunda columna, y sigue antes de
         #donde-se-pega con la cifra y su fuente juntas. */}
    <section class="acto video-demo" id="demo">
      <h2 class="rubric">{video.titulo}</h2>
      <div class="video-demo__marco">
        <video
          controls
          preload="none"
          playsinline
          width="1920"
          height="1080"
          poster={url(`/video/echo-demo-${lang}.webp`)}
          aria-label={video.descripcion}
        >
          <source src={url(`/video/echo-demo-${lang}.mp4`)} type="video/mp4" />
        </video>
        <button type="button" class="video-demo__play" aria-label={video.reproducir} hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
        </button>
      </div>
      <div class="veloc">
        <p class="veloc__fila">
          <span class="veloc__modo">{tecleando.modo}</span>
          <span class="veloc__valor">{tecleando.ppm}</span>
        </p>
        <p class="veloc__fila">
          <span class="veloc__modo">{hablando.modo}</span>
          <span class="veloc__valor veloc__valor--bien">{hablando.ppm}</span>
        </p>
        <p class="microcopy veloc__fuente">{velocidad.fuente}</p>
      </div>
    </section>

    {/* CÓMO FUNCIONA · dos secciones que se leen como un solo bloque: dónde
         acaba el texto y qué pasa por el camino. Van juntas, con poco aire
         entre ellas (`.acto--sigue`), y separadas del resto con mucho. */}
    <section class="acto acto--bloque" id="donde-se-pega">
      <h2 class="rubric">{dondeSePega.titulo}</h2>
      <ul class="carrusel">
        {
          dondeSePega.piezas.map((p) => (
            <li class="carrusel__pieza">
              <Icono nombre={p.icono} />
              <span class="carrusel__etiqueta">{p.etiqueta}</span>
            </li>
          ))
        }
      </ul>
      <p class="c-lead">
        {dondeSePega.cuerpo.map((s) => (s.enfasis ? <em>{s.texto}</em> : s.texto))}
      </p>
    </section>

    <section class="acto acto--sigue">
      <h2 class="rubric" id="como-funciona">{pasos.rotulo}</h2>
      <ol class="pasos">
        {
          pasos.lista.map((paso) => (
            <li>
              <span class="c-dim" aria-hidden="true">{paso.n}</span>
              <h3>{paso.titulo}</h3>
              <p class="pasos__texto">
                {paso.partes.map((t) => (t.dato ? <strong>{t.texto}</strong> : t.texto))}
              </p>
              {/* MAK-229: «Puliendo con Claude…» en el píxel de la app — la
                   única prueba visual de que el pulido corre contra la
                   suscripción que el visitante ya paga. Solo en este paso
                   (identidad por referencia contra `pasos.lista[1]`, no por
                   índice suelto). Carga perezosa: no está en el primer
                   pantallazo. */}
              {paso === pasos.lista[1] && (
                <picture class="paso__pildora">
                  <source srcset={url('/producto/hud_polishing.avif')} type="image/avif" />
                  <source srcset={url('/producto/hud_polishing.webp')} type="image/webp" />
                  <img
                    src={url('/producto/hud_polishing.png')}
                    width="280"
                    height="119"
                    alt={imagenes.pildoraPuliendo}
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    {/* LA COMPARATIVA · cuatro correcciones, ni una más. Es el único titular
         grande de la página después de la apertura: aquí se decide si pagar. */}
    <section class="acto acto--bloque">
      <h2 id="comparacion">{comparativa.titulo}</h2>
      <p class="c-lead">{comparativa.entradilla}</p>

      <div class="comparativa">
        {
          comparativa.filas.map((fila) => (
            <div class="corr" data-fila-comparativa>
              <p class="crit">{fila.criterio}</p>
              <p>
                <span class="sr-only">{comparativa.columnas.macos}: </span>
                <span class="mal tach">{fila.macos}</span>
              </p>
              <p class="bien">
                <span class="sr-only">{comparativa.columnas.echo}: </span>{fila.echo}
              </p>
              {/* MAK-245: el ejemplo del deploy. */}
              {'nota' in fila && <p class="microcopy corr__nota">{fila.nota}</p>}
            </div>
          ))
        }
      </div>
    </section>

    {/* EL CIERRE · cero marcas: la página ya está limpia. Para quién no es, y
         el segundo y último botón (MAK-251), con las mismas condiciones. */}
    <section class="acto acto--bloque">
      <p class="final">
        {comparativa.cierre.concesion} {comparativa.cierre.afirmacion}
      </p>
      <p><a class="btn" href={url('/descarga')}>{apertura.cta}</a></p>
      <p class="c-dim apertura__requisito">
        {apertura.requisito.aviso.map((t) => (t.dato ? <strong>{t.texto}</strong> : t.texto))}{' '}{apertura.requisito.maquina}
      </p>
    </section>

    {/* LAS DUDAS · privacidad, preguntas y contacto, un solo bloque al final
         para quien todavía no se ha decidido. */}
    <section class="acto acto--bloque">
      <h2 class="rubric">{privacidad.rotulo}</h2>
      <p class="c-lead privacidad">{privacidad.principal}</p>
    </section>

    <section class="acto acto--sigue" id="preguntas">
      <h2 class="rubric">{preguntas.rotulo}</h2>
      <div class="faq">
        {
          preguntas.lista.map((q) => (
            <details class="qa">
              <summary>{q.p}</summary>
              <p>{q.r}</p>
            </details>
          ))
        }
      </div>
    </section>

    {/* MAK-243: una sola línea con un mailto pelado. */}
    <section class="acto acto--sigue contacto" id="contacto">
      <p class="c-lead">
        {contacto.texto}<a class="top__cta" href={mailtoContacto}>{contacto.boton}</a>
      </p>
    </section>
  </main>

  <Footer lang={lang} otroIdiomaHref={otroIdiomaHref} />
</Base>

<script>
  import { iniciarTachado } from '../components/correccion/tachado'
  import { iniciarFaq } from '../components/correccion/faq'
  import { iniciarVideo } from '../components/correccion/video'

  const contenido = document.getElementById('contenido')
  if (contenido) {
    iniciarTachado(contenido)
    iniciarFaq(contenido)
  }
  const video = document.querySelector<HTMLElement>('.video-demo__marco')
  if (video) iniciarVideo(video)
</script>
