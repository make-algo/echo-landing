---
import { RUTAS_LEGALES, url } from '../lib/site'
import { DEFAULT_LOCALE, getCopy, type Locale } from '../i18n/copy'

interface Props {
  lang?: Locale
  /**
   * Esta misma página en el otro idioma, ya resuelta con `url()`. Si no se
   * pasa, esta página todavía no tiene versión en el otro idioma (la descarga
   * y la invitación, por ahora) y el selector no se pinta — mejor ningún
   * enlace que uno que caiga en un 404.
   */
  otroIdiomaHref?: string
}
const { lang = DEFAULT_LOCALE, otroIdiomaHref } = Astro.props
const { pie } = getCopy(lang)
/** Las legales sí existen en los dos idiomas: cada pie enlaza a las suyas. La descarga sigue en español. */
const legales = RUTAS_LEGALES[lang]
const ETIQUETA_OTRO_IDIOMA: Record<Locale, string> = { es: 'Español', en: 'English' }
const otroIdioma: Locale = lang === 'es' ? 'en' : 'es'
---

<footer class="footer">
  <div class="wrap">
    <p>{pie.linea}</p>
    {/*
      Cookies no tiene página propia: esta web no usa cookies y la afirmación va
      publicada dentro de la política de privacidad, que es lo acordado en vez
      de una tercera página.
    */}
    <p class="legal">
      <a href={url('/descarga')}>{pie.descargar}</a><a href={url(legales.avisoLegal, lang)}>{pie.avisoLegal}</a><a href={url(legales.condiciones, lang)}>{pie.condiciones}</a><a href={url(legales.privacidad, lang)}>{pie.privacidad}</a>{
        otroIdiomaHref && (
          <a href={otroIdiomaHref} hreflang={otroIdioma} lang={otroIdioma}>
            {ETIQUETA_OTRO_IDIOMA[otroIdioma]}
          </a>
        )
      }
    </p>
  </div>
</footer>
