---
import Dicho from './demo/Dicho.astro'
import Escrito from './demo/Escrito.astro'
import { demo } from '../content/copy'

/**
 * Demo animada del control — «Así se ve».
 *
 * Dos huecos independientes, para que el vídeo real entre sin rehacer la
 * sección: `.demo__media` lleva la proporción y el tamaño y el contenido no
 * los fija —sustituirlo por <video poster muted loop playsinline> no mueve un
 * píxel—, y el pie es un elemento aparte.
 *
 * `demo-anim` es lo que engancha la animación: se pone en el ancestro común de
 * las dos mitades, sea cual sea la composición. Las variantes reparten `Dicho`
 * y `Escrito` por su propia retícula y ponen `demo-anim` donde les toca.
 *
 * El texto de dentro (campos del correo, «Grabando», «Puliendo», la frase
 * dictada) es interfaz recreada, no copy de la página.
 */
---

<figure class="demo" id="demo">
  <h2 class="sr-only">{demo.tituloOculto}</h2>

  <p class="sr-only">{demo.descripcion}</p>

  <div class="demo__media demo-anim">
    <Escrito />
    <Dicho />
  </div>

  <div class="demo__foot">
    <figcaption class="demo__caption">{demo.pie}</figcaption>
  </div>
</figure>
