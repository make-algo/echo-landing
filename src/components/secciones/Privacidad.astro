---
import { privacidad } from '../../content/copy'

/** 6 · Privacidad. Se lee como una explicación, no como un sello: ni una
    negrita, ni un icono, ni una caja. */
---

<section id="privacidad" class="section">
  <div class="wrap">
    <h2 class="rubric">{privacidad.rotulo}</h2>
    <div class="priv">
      <p class="priv__main">{privacidad.principal}</p>
      <div class="priv__notes fila-med">
        {privacidad.notas.map((n) => <p>{n}</p>)}
      </div>
    </div>
  </div>
</section>
