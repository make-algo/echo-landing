---
import { pasos } from '../../content/copy'

/** 4 · Cómo funciona: una tira continua, no tres tarjetas. */
---

<section id="como-funciona" class="section">
  <div class="wrap">
    <h2 class="rubric">{pasos.rotulo}</h2>
    <ol class="steps">
      {
        pasos.lista.map((paso) => (
          <li>
            <h3>{paso.titulo}</h3>
            <p>{paso.partes.map((t) => (t.dato ? <span class="t">{t.texto}</span> : t.texto))}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
