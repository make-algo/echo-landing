---
import { preguntas } from '../../content/copy'

/** 9 · Preguntas. `<details>` nativo a una columna. */
---

<section id="preguntas" class="section">
  <div class="wrap">
    <h2 class="rubric">{preguntas.rotulo}</h2>
    <div class="faq">
      {
        preguntas.lista.map((q) => (
          <details class="qa">
            <summary>{q.p}</summary>
            <p>{q.r}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
