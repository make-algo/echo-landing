---
import { argumentos } from '../../content/copy'

/** 3 · Tres argumentos, en orden de fuerza. Lista apilada, no tres tarjetas. */
---

<section id="que-hace-distinto" class="section">
  <div class="wrap">
    <h2 class="rubric">{argumentos.rotulo}</h2>
    <div class="args">
      {
        argumentos.lista.map((a) => (
          <div class="arg">
            <h3>{a.titulo}</h3>
            <p>{a.texto}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
