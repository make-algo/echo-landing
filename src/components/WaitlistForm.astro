---
import { url } from '../lib/site'
import { beta } from '../content/copy'

/**
 * Lista de espera.
 *
 * No hay formulario ni backend propio: el botón es un enlace `mailto:` que
 * abre el cliente de correo del visitante con el asunto y las dos preguntas
 * ya escritas en el cuerpo. El envío lo hace su propio cliente de correo,
 * esta página no guarda ni transmite nada.
 */
interface Props {
  /**
   * Clase extra del bloque, para que cada variante lleve el alta a SU sistema
   * sin duplicar ni la lógica ni una sola palabra del texto legal. Lo que
   * cambia es la piel; el destino y la redacción de protección de datos son
   * los mismos en las cuatro rutas.
   */
  clase?: string
}

const { clase = '' } = Astro.props

const destino = 'hola@make-algo.com'
const asunto = 'Alta en la lista de espera de echo'
const cuerpo = [
  beta.uso.etiqueta,
  '',
  '',
  `${beta.sub.etiqueta} (${beta.sub.opciones.join(' / ')})`,
  '',
  '',
].join('\n')
const mailto = `mailto:${destino}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`
---

<div class:list={['beta__body', clase]}>
  <div class="beta__cta">
    <a class="btn btn--submit" href={mailto}>{beta.boton}</a>

    <p class="microcopy">{beta.microcopy}</p>

    <!--
      Texto legal de protección de datos, visible junto al botón y no tras un
      enlace: es lo que hace que no haga falta checkbox de consentimiento.
      No se reescribe. Los huecos los rellena un humano antes de publicar en
      dominio propio.

      TODO: pendiente de revisión legal (ver issue de asesor-legal) — sigue
      mencionando a Formspree como encargado del tratamiento, y ya no hay
      formulario ni proveedor de por medio: es un mailto directo al buzón de
      Make Algo.
    -->
    <p class="legalnote" id="legalnote">
      <strong>{beta.legal.titulo}</strong>{beta.legal.uno}<a href={url('/privacidad')}
        >{beta.legal.enlace}</a
      >{beta.legal.dos}<span class="pending">{beta.legal.pendiente}</span>{beta.legal.tres}
    </p>

    <div class="done">
      <p>{beta.ok.texto}</p>
      <p>{beta.ok.extra}</p>
    </div>
  </div>
</div>
