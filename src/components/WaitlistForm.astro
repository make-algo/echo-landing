---
import { url } from '../lib/site'
import { beta } from '../content/copy'

/**
 * Contacto por email.
 *
 * No hay formulario ni backend propio: el enlace es un `mailto:` que abre el
 * cliente de correo del visitante con el asunto y las dos preguntas ya
 * escritas en el cuerpo. El envío lo hace su propio cliente de correo, esta
 * página no guarda ni transmite nada.
 *
 * El CTA principal de la landing lleva a descargas (MAK-188): este enlace
 * queda como vía secundaria y discreta, sin el estilo de botón primario.
 */
interface Props {
  /**
   * Clase extra del bloque, para que cada variante lleve el alta a SU sistema
   * sin duplicar ni la lógica ni una sola palabra del texto legal. Lo que
   * cambia es la piel; el destino y la redacción de protección de datos son
   * los mismos en las cuatro rutas.
   */
  clase?: string
}

const { clase = '' } = Astro.props

const destino = 'hola@make-algo.com'
const asunto = 'Sobre echo'
const cuerpo = [
  beta.uso.etiqueta,
  '',
  '',
  `${beta.sub.etiqueta} (${beta.sub.opciones.join(' / ')})`,
  '',
  '',
].join('\n')
const mailto = `mailto:${destino}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`
---

<div class:list={['beta__body', clase]}>
  <div class="beta__cta">
    <a class="top__cta" href={mailto}>{beta.boton}</a>

    <p class="microcopy">{beta.microcopy}</p>

    {/*
      Frase de primera capa (art. 13 RGPD): responsable, finalidad y remisión
      a la política de privacidad, visible junto al botón sin necesidad de
      clic. El checkbox de consentimiento no depende de dónde esté este
      texto, sino de la base jurídica del tratamiento (aquí no es
      consentimiento) — ver dictamen en MAK-227. No se reescribe el
      contenido legal sin pasar por asesor-legal.

      El resto del art. 13 (base legal, plazo de conservación, destinatarios,
      derechos, reclamación ante la AEPD) vive en /privacidad y no se repite
      aquí.
    */}
    <p class="legalnote" id="legalnote">
      <strong>{beta.legal.titulo}</strong>{beta.legal.uno}<a href={url('/privacidad')}
        >{beta.legal.enlace}</a
      >{beta.legal.dos}
    </p>

    <div class="done">
      <p>{beta.ok.texto}</p>
      <p>{beta.ok.extra}</p>
    </div>
  </div>
</div>
