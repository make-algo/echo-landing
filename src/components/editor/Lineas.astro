---
import { lineas } from '../../lib/lineas'

interface Props {
  /** El texto, tal cual sale de la fuente única. Aquí no se reescribe nada. */
  texto: string
  /** Etiqueta del bloque. `p` por defecto; `h1` y `h2` para los titulares. */
  como?: 'p' | 'h1' | 'h2' | 'h3'
  /** Columnas a las que se envuelve. 72 es el ancho del búfer. */
  ancho?: number
  clase?: string
}

/**
 * Un bloque de texto partido en líneas de origen, para que el canal de
 * numeración no mienta: cada número señala una línea real.
 *
 * El texto sigue viviendo en UN solo elemento, así que en voz alta se lee
 * entero, seguido y en orden; lo que se parte es la composición, no el
 * contenido. Y como se parte por espacios y los renglones se vuelven a unir por
 * un espacio, el texto generado es idéntico carácter a carácter al de la fuente.
 *
 * El número lo pone un contador de CSS y no un elemento: si fuera texto real se
 * colaría entre las palabras del copy aprobado y rompería las frases que la
 * comprobación de despliegue exige seguidas.
 */
const { texto, como = 'p', ancho = 72, clase = '' } = Astro.props
const Etiqueta = como
const renglones = lineas(texto, ancho)
---

<Etiqueta class:list={['lineas', clase]}>
  {renglones.map((l) => <span class="ln"><span class="v">{l}</span></span>)}
</Etiqueta>
