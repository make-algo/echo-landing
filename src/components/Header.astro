---
import { url } from '../lib/site'
import { cabecera } from '../content/copy'

/**
 * Cabecera mínima: la marca en pantalla y un acceso permanente al alta.
 * Sin navegación: la página tiene un objetivo y una barra de enlaces ofrecería
 * salidas. Lo único que resuelve es que alguien que entra y se va a los tres
 * segundos sepa cómo se llama el producto.
 *
 * Pegajosa en las cinco rutas (MAK-231): el botón de descarga sigue visible
 * pasada la primera pantalla, sin volver arriba. El CSS vive en `global.css`.
 */
---

<header class="top">
  <div class="wrap">
    <a class="wordmark" href={url('/')}>{cabecera.marca}</a>
    <a class="top__cta" href={url('/descarga')}>{cabecera.cta}</a>
  </div>
</header>
