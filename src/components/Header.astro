---
import { url } from '../lib/site'
import { DEFAULT_LOCALE, getCopy, type Locale } from '../i18n/copy'

interface Props {
  lang?: Locale
}
const { lang = DEFAULT_LOCALE } = Astro.props
const { cabecera } = getCopy(lang)

/**
 * Cabecera mínima: la marca en pantalla y un acceso permanente al alta.
 * Sin navegación: la página tiene un objetivo y una barra de enlaces ofrecería
 * salidas. Lo único que resuelve es que alguien que entra y se va a los tres
 * segundos sepa cómo se llama el producto.
 *
 * Pegajosa en las cinco rutas (MAK-231): el botón de descarga sigue visible
 * pasada la primera pantalla, sin volver arriba. El CSS vive en `global.css`.
 *
 * El logo lleva a la portada EN ESTE idioma (MAK-274); la descarga sigue
 * yendo a `/descarga`, que todavía no existe en inglés.
 */
---

<header class="top">
  <div class="wrap">
    <a class="wordmark" href={url('/', lang)}>{cabecera.marca}</a>
    <div class="top__acciones">
      {/*
        Selector de idioma. Oculto en el HTML: lo enseña el guion de <Base>
        solo si esta página existe en el otro idioma (un `hreflang` alterno o
        los dos bloques de /descarga). Sin JavaScript queda el enlace del pie.
      */}
      <select class="top__idioma" aria-label={cabecera.idioma} data-selector-idioma hidden>
        <option value="es" lang="es" selected={lang === 'es'}>Español</option>
        <option value="en" lang="en" selected={lang === 'en'}>English</option>
      </select>
      <a class="top__cta" href={url('/descarga')}>{cabecera.cta}</a>
    </div>
  </div>
</header>
